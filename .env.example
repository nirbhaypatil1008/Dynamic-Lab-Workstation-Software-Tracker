API_HOST=127.0.0.1
API_PORT=3001
CORS_ORIGIN=http://localhost:5173
HEARTBEAT_TIMEOUT_SECONDS=90
DATABASE_PATH=./data/lab-tracker.sqlite
COOKIE_SECURE=false

# Set a unique, private value only while provisioning the first administrator.
# Do not commit or share the actual value.
ADMIN_SETUP_TOKEN=replace-with-a-long-random-one-time-value

# Optional frontend override; the default is http://localhost:3001
# VITE_API_URL=http://localhost:3001

# Agent-side input inactivity threshold before reporting Idle (seconds).
LAB_TRACKER_IDLE_AFTER_SECONDS=600
